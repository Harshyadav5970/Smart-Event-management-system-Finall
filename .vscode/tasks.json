{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Backend Server",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "eventhub",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Start Frontend Client",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "eventhub",
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Full Stack (EventHub)",
      "dependsOn": [
        "Start Backend Server",
        "Start Frontend Client"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
